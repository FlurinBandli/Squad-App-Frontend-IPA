# Example environment variables for the NestJS API Backend
# Replace the values with your actual credentials and API URL
NEST_API_URL=http://localhost:3001
NEST_USERNAME=changeme
NEST_PASSWORD=changeme

# Example environment variables for NextAuth.js authentication
NEXTAUTH_SECRET=generate-a-secret-here

# Base URL for the Next.js frontend application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin credentials used by the Credentials provider in NextAuth.js
AUTH_USERNAME=changeme
AUTH_PASSWORD=changeme